# Kenya SME Financial Intelligence Platform - Environment Variables
# Copy to .env and fill with real values. Never commit .env to version control.

# Django
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=django_app.settings

# Databases
DATABASE_URL=postgresql://sme_user:sme_pass@localhost:5432/sme_financial_intelligence
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM (OpenAI-compatible endpoint)
# Example: OpenAI
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

# Example: local Ollama
# OPENAI_API_KEY=ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
# Docker Desktop on Windows/Mac reaching the host Ollama:
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_CLASS=SmeDocument

# MLflow / DagsHub
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_USERNAME=
MLFLOW_PASSWORD=
MLFLOW_EXPERIMENT=kenya-sme-financial-intelligence

# Security
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_CURRENCY=KES
DATA_DIR=data/synthetic
MODELS_DIR=models
